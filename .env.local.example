# ──────────────────────────────────────────────────────────────────────────
# Copy this file to `.env.local` and fill in your values. `.env.local` is
# gitignored and read only on the server — your credentials never reach the
# browser. Configure one or both providers; unconfigured ones are skipped.
# ──────────────────────────────────────────────────────────────────────────

# Default season for both providers (override per-provider below if needed).
FANTASY_SEASON=2026

# ── ESPN (private league) ──────────────────────────────────────────────────
# League id: the `leagueId=` number in your ESPN fantasy URL.
ESPN_LEAGUE_ID=
# Your team's id within that league (the `teamId=` in the team page URL).
ESPN_TEAM_ID=
# ESPN_SEASON=2026
#
# Private-league auth cookies. In a browser logged into ESPN, open DevTools →
# Application/Storage → Cookies → fantasy.espn.com, and copy these two values:
ESPN_S2=
# SWID including the surrounding braces, e.g. {XXXXXXXX-XXXX-...}
ESPN_SWID=

# ── CBS (private league) ───────────────────────────────────────────────────
# League subdomain: for myleague.baseball.cbssports.com -> CBS_LEAGUE_HOST=myleague
CBS_LEAGUE_HOST=
# Your team's id within the CBS league.
CBS_TEAM_ID=
# CBS_SEASON=2026
#
# PREFERRED: API access token. In your CBS League Office, enable API Access and
# paste the token here.
CBS_ACCESS_TOKEN=
# FALLBACK (only if no token): the raw Cookie header from a logged-in CBS
# session. Scrape parsing is not implemented yet — see src/lib/cbs/client.ts.
CBS_COOKIE=

# ── FantasyPros (My Playbook — free-agent ROS rankings) ────────────────────
# Powers the Free Agents page using FantasyPros' league-synced, scoring-aware
# ROS rankings. Login-only (no public API): paste the raw Cookie header from a
# logged-in fantasypros.com request (DevTools → Network → any request → Cookie).
# Long-lived but expires; re-copy if free agents stop loading.
FANTASYPROS_COOKIE=
# Per-league "My Playbook" keys. In FantasyPros, the available-players URL uses
# ?key=mlb~<UUID>; copy each league's key here. Leave blank to skip that league.
FANTASYPROS_ESPN_KEY=
FANTASYPROS_CBS_KEY=
